{
  "name": "matcha-luna-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matcha Luna costing, inventory, and point-of-sale application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:legacy": "playwright test tests/e2e/legacy-suite.spec.ts --project=chromium-desktop",
    "test:assets": "playwright test tests/e2e/assets.spec.ts --project=chromium-desktop",
    "test:compatibility": "playwright test tests/e2e/compatibility.spec.ts --project=chromium-desktop",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
